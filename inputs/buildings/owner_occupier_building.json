    {
      "type": "nrg3:HeatPump",
      "parent": "id_building_1",
      "id": "heat_pump_1",
      "description": "NIBE F1255 PC ground-source heat pump on a vertical ground collector (bodemwarmte). Source 24 \u00b0C / system 31 \u00b0C. Pipework is insulated. The unit sits inside the thermal envelope; EnergyADE 3.0 has no native attribute for in-envelope vs outside-envelope placement, so this is recorded here in the description. The COP value (5.5) is a representative mid-range figure estimated from NIBE F1255 PC datasheet performance curves (manufacturer typical: COP \u2248 4.7 at 0\u00b0C source / 35\u00b0C heating, COP \u2248 6.5 at 10\u00b0C source / 35\u00b0C heating); the 24\u00b0C source / 31\u00b0C operation pair recorded here implies an unusually small temperature lift and would in principle yield a higher COP, but no per-installation measurement was collected so a conservative middle of the typical range is used.",
      "name": ["NIBE F1255 PC"],
      "creation_date": "2026-04-13",
      "model": "NIBE F1255 PC",
      "identifier": [{"value": "F1255 PC", "code_space": "https://www.nibe.eu/nl-nl/producten/warmtepompen/water-water-warmtepompen/f1255-pc"}],
      "number_of_devices": 1,
      "installed_power": {"value": 6000, "uom": "W"},
      "heat_source": {"value": "verticalGroundCollector", "code_space": "http://3dcities.bk.tudelft.nl/citygml/2.0/energy/3.0/HeatSourceValue.xml"},
      "cop_source_temperature": {"value": 24, "uom": "C"},
      "cop_operation_temperature": {"value": 31, "uom": "C"},
      "nominal_efficiency": {"value": 5.5, "uom": "W/W"}
    },
