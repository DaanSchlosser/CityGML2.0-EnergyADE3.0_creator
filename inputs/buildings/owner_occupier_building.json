    {
      "type": "nrg3:Energy",
      "parent": "id_building_unit_1",
      "id": "id_house_consumption_1",
      "description": "Whole-house final-electricity consumption from smart-meter import readings, monthly aggregates Jan 2022 – Jun 2025 (42 months). Recorded at BuildingUnit (VBO) scope because the smart meter is per-VBO and no per-end-use breakdown was collected; `end_use=otherOrCombination` is the codelist-honest pick for mixed end-uses on a single carrier. Includes everything the meter sees (heat-pump, EV charging, appliances, lighting). The PV self-consumption is *not* netted out — these are gross household consumption figures.",
      "name": ["House electricity consumption"],
      "creation_date": "2026-05-04",
