<?xml version="1.0" encoding="UTF-8"?>
<UOMList xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="XSD/UOMListe.xsd">
	<description>
		Unit of Measurements from Energy ADE
	</description>
	<date>
		2026-05-27
	</date>
	<version>
		1.2
	</version>
	<UOM name="AMPERE" id="A" quantity="ELECTRIC_CURRENT" sign="A" description="Unit for electric current"/>
	<UOM name="CANDELA" id="cd" quantity="LUMINOUS_INTENSITY" sign="cd" description="Unit for luminous intensity"/>
	<!-- DEGREE_CELSIUS: UCUM (https://ucum.org/ucum) codes degree Celsius as the
	     case-sensitive symbol "Cel". Bare "C" is UCUM's COULOMB, and "°C" is only
	     the print symbol, so a uom="C" temperature is read as electric charge by
	     any UCUM-aware consumer. id corrected from "C" to "Cel" on 2026-06-10. -->
	<UOM name="DEGREE_CELSIUS" id="Cel" quantity="TEMPERATURE" sign="°C" description="Unit for thermodynamic temperature"/>
	<UOM name="KELVIN" id="K" quantity="TEMPERATURE" sign="K" offset="273.15" description="Unit for thermodynamic temperature">
		<altId>
			k
		</altId>
	</UOM>
	<UOM name="FARAD" id="F" quantity="ELECTRIC_CAPACITY" sign="F" description="Unit for electric capacity"/>
	<UOM name="GRAM" id="g" quantity="MASS" sign="g" factor="1.0E-3" description="Unit for mass"/>
	<UOM name="KILOGRAM" id="kg" quantity="MASS" sign="kg" factor="1.0" description="Unit for mass"/>
	<UOM name="NANOGRAM" id="ng" quantity="MASS" sign="ng" factor="1.0E-12" description="Unit for mass"/>
	<UOM name="HENRY" id="H" quantity="INDUCTANCE" sign="H" description="Unit for inductance"/>
	<UOM name="HERTZ" id="Hz" quantity="FREQUENCY" sign="1/s" description="Unir for frequency"/>
	<UOM name="KILOWATT_HOUR" id="kWh" quantity="ENERGY" factor="1.0" sign="kWh" description="Unit for energy">
		<altId>
			KwH
		</altId>
		<altId>
			kwh
		</altId>
	</UOM>
	<UOM name="MEGAWATT_HOUR" id="MWh" quantity="ENERGY" factor="0.001" sign="MWh" description="Unit for energy"/>
	<UOM name="MEGAWATT_HOUR_PER_YEAR" id="MWh/a" quantity="ENERGY_PER_TIME" sign="MWh/a" description="Unit for annual energy (megawatt-hours per annum)"/>
	<UOM name="WATT_HOUR" id="Wh" quantity="ENERGY" factor="1000.0" sign="Wh" description="Unit for energy">
		<altId>
			WH
		</altId>
		<altId>
			wh
		</altId>
	</UOM>
	<UOM name="JOULE" id="J" quantity="ENERGY" sign="J" factor="3.6E6" description="Unit for energy">
		<altId>
			j
		</altId>
	</UOM>
	<UOM name="KILOJOULE" id="kJ" quantity="ENERGY" sign="kJ" factor="3.6E3" description="Unit for energy">
		<altId>
			kj
		</altId>
	</UOM>
	<UOM name="LUMEN" id="lm" quantity="LUMINOUS_FLUX" sign="lm" description="Unit for luminous flux"/>
	<UOM name="LUX" id="lx" quantity="ILLUMINANCE" sign="lx" description="Unit for illuminance"/>
	<UOM name="METRE" id="m" description="Unit for length" factor="1.0" quantity="LENGTH" sign="m">
		<altId>
			urn:adv:uom:m
		</altId>
	</UOM>
	<UOM name="MILLIMETRE" id="mm" description="Unit for length" factor="1000.0" quantity="LENGTH" sign="mm"/>
	<UOM name="CENTIMETRE" id="cm" description="Unit for length" factor="100.0" quantity="LENGTH" sign="cm"/>
	<UOM name="SQUARE_METRE" id="m2" description="Unit for area" quantity="AREA" sign="m²">
		<altId>
			urn:adv:uom:m2
		</altId>
	</UOM>
	<UOM name="CUBIC_METRE" id="m3" description="Unit for volume" quantity="VOLUME" sign="m³">
		<altId>
			urn:adv:uom:m3
		</altId>
	</UOM>
	<UOM name="MOLE" id="mol" quantity="SUBSTANCE_AMOUNT" sign="mol" description="Unit for amount of substance"/>
	<UOM name="NEWTON" id="N" quantity="FORCE" sign="N" description="Unit for force"/>
	<UOM name="OHM" id="Ohm" quantity="ELECTRIC_RESISTANCE" sign="Ω" description="Unit for electric resistance"/>
	<UOM name="PASCAL" id="Pa" quantity="PRESSURE" sign="Pa" factor="1.0E0" description="Unit for pressure"/>
	<UOM name="BAR" id="bar" quantity="PRESSURE" sign="bar" factor="1.0E-5" description="Unit for pressure"/>
	<UOM name="RADIAN" id="rad" description="Unit for plane angle" factor="1" quantity="ANGLE" sign="rad">
		<altId>
			urn:adv:uom:m
		</altId>
	</UOM>
	<UOM name="DEGREE" id="grad" quantity="ANGLE" sign="º" factor="0.017453292" description="Unit for plane angle">
		<altId>
			urn:adv:uom:grad
		</altId>
		<altId>
			deg
		</altId>
	</UOM>
	<UOM name="SECOND" id="s" quantity="TIME" sign="sec" factor="3600.0" description="Unit for time"/>
	<UOM name="HOUR" id="h" quantity="TIME" sign="hour" factor="1" description="Unit for time"/>
	<UOM name="SIEMENS" id="S" quantity="ELECTRIC_CONDUCTANCE" sign="S" description="Unit for electric conductance"/>
	<UOM name="VOLT" id="V" quantity="VOLTAGE" sign="V" description="Unit for electric voltage"/>
	<UOM name="WATT" id="W" quantity="POWER" sign="W" factor="1000.0" description="Unit for power">
		<altId>
			w
		</altId>
	</UOM>
	<UOM name="KILOWATT" id="kW" quantity="POWER" factor="1.0" sign="kW">
		<altId>
			kw
		</altId>
	</UOM>
	<UOM name="WEBER" id="Wb" quantity="MAGNETIC_FLUX" sign="Wb" description="Unit for magnetic flux"/>
	<UOM name="DENSITY_KG" id="kg/m3" quantity="DENSITY" sign="kg/m³" factor="1.0" description="Unit for volumetric mass density">
		<altId>
			kgm-3
		</altId>
	</UOM>
	<UOM name="DENSITY_G" id="g/m3" quantity="DENSITY" sign="g/m³" factor="1000.0" description="Unit for volumetric mass density">
		<altId>
			gm-3
		</altId>
	</UOM>
	<UOM name="METER_PER_SECOND" id="m/s" quantity="SPEED" sign="m/sec" description="Unit for speed"/>
	<UOM name="THERMAL_CONDUCTIVITY" id="W/(K*m)" quantity="THERMAL_CONDUCTIVITY" sign="W/(m*K)" description="Unit for thermal conductivity">
		<altId>
			W/(m*K)
		</altId>
		<altId>
			wm-1k-1
		</altId>
	</UOM>
	<UOM name="PERM" id="ng/(m2*Pa*s)" quantity="PERMEABILITY" sign="ng/(sec*m²*P)" description="Unit for water vapor transmission">
		<altId>
			ngs-1m-2p-1
		</altId>
	</UOM>
	<UOM name="SPECIFIC_HEAT_KJ" id="kJ/(kg*K)" quantity="SPECIFIC_HEAT_CAPACITY" sign="kJ/(K*kg)" factor="1.0" description="Unit for specific heat">
		<altId>
			kJ/(K*kg)
		</altId>
		<altId>
			kjkg-1k-1
		</altId>
	</UOM>
	<UOM name="SPECIFIC_HEAT_J" id="J/(kg*K)" quantity="SPECIFIC_HEAT_CAPACITY" sign="J/(K*kg)" factor="1000.0" description="Unit for specific heat">
		<altId>
			J/(K*kg)
		</altId>
		<altId>
			jkg-1k-1
		</altId>
	</UOM>
	<UOM name="WATT_PER_SQUAREMETER" id="W/m2" quantity="POWER_PER_AREA" sign="W/m²" factor="1.0" description="Irradiance">
		<altId>
			wm-2
		</altId>
	</UOM>
	<UOM name="WATT_PER_PERSON" id="W/Persons" quantity="POWER_PER_PERSON" sign="W/Persons" factor="1.0" description="">
		<altId>
			wpersons-1
		</altId>
	</UOM>
	<UOM name="SQUAREMETER_PER_PERSON" id="m2/Persons" quantity="AREA_PER_PERSON" sign="m²/Persons" factor="1.0" description="">
		<altId>
			m2persons-1
		</altId>
	</UOM>
	<UOM name="PERSONS_NUMBER" id="Persons" quantity="PERSONS" sign="Persons" factor="1.0" description=""/>
	<UOM name="JOULE_PER_SECOND_SQUARE_CM" id="J/(sec*cm2)" quantity="POWER_PER_AREA" sign="J/(sec*cm²)" factor="0.36" description="Irradiance"/>
	<UOM name="KILOWATT_HOUR_PER_SQUAREMETER" id="kWh/m2" quantity="ENERGY_PER_AREA" sign="kWh/m²" factor="1.0" description="Energy per area">
		<altId>
			kwhm-2
		</altId>
	</UOM>
	<!-- UVALUE: the id "W/K*m2" parses by left-to-right precedence as (W/K)*m2 =
	     W*m2/K, the inverse of a thermal transmittance. The correct, unambiguous
	     form is W/(m2*K) = W*m-2*K-1. id corrected from "W/K*m2" to "W/(m2*K)" on
	     2026-06-10. -->
	<UOM name="UVALUE" id="W/(m2*K)" quantity="UVALUE" sign="W/(m²*K)" description="Unit for thermal transmittance">
		<altId>
			W(K*m^2)-1
		</altId>
		<altId>
			wm-2k-1
		</altId>
	</UOM>
	<UOM name="RVALUE" id="K*m2/W" quantity="THERMAL_RESISTANCE" sign="(m²K)/W" description="Unit for thermal resistance">
		<altId>
			m2kw-1
		</altId>
	</UOM>
	<UOM name="FLOW_RATE" id="m3/s" quantity="FLOW_RATE" sign="m³/sec" factor="1.0" description="Unit for flow rate (qubic metre per second) of a liquid medium">
		<altId>
			m3s-1
		</altId>
	</UOM>
	<UOM name="FLOW_RATE_LITER" id="l/s" quantity="FLOW_RATE" sign="l/sec" factor="0.001" description="Unit for flow rate (liter per second) of a liquid medium">
		<altId>
			ls-1
		</altId>
	</UOM>
	<UOM name="FLOW_RATE_PER_HOUR" id="m3/h" quantity="FLOW_RATE" sign="m³/h" factor="3600.0" description="Unit for flow rate (qubic metre per hour) of a liquid medium">
		<altId>
			m3s-1
		</altId>
	</UOM>
	<UOM name="LITER_PER_SECOND_PER_SQUARE_METER" id="l/m2*sec" quantity="VOLUME_FLOW_DENSITY" sign="l/m²sec" factor="0.001" description="Unit for volume flow density (liter per qubic metre per second) of a liquid medium">
		<altId>
			lm-2s-1
		</altId>
	</UOM>
	<UOM name="SCALE" id="scale" quantity="SCALE" sign="%" factor="1.0" description="Ratio of two measures, value between 0 and 1"/>
	<UOM name="PERCENTAGE" id="percent" quantity="SCALE" sign="%" factor="0.01" description="Percentage, value between 0 and 100"/>
	<UOM name="CLOUDINESS_8" id="cloud" quantity="CLOUDINESS" sign="eights" factor="1.0" description="Cloudiness, 0 - 8 eighth"/>
	<UOM name="CLOUDINESS_10" id="cloud_10" quantity="CLOUDINESS" sign="tenth" factor="1.25" description="Cloudiness, 0 - 10 tenth"/>
	<UOM name="ELECTRIC_CONDUCTIVITY" id="S/m" quantity="ELECTRIC_CONDUCTIVITY" sign="S/m">
		<altId>
			Sm-1
		</altId>
	</UOM>
	<UOM name="DIMENSIONLESS_NUMBER" id="-" quantity="DIMENSIONLESS_NUMBER" sign="-"/>
	<UOM name="AIR_CHANGE_RATE_HOUR" id="1/h" quantity="AIR_CHANGE_RATE" sign="1/h"/>
	<UOM name="AREA_THERMAL_RESISTANCE" id="m2*K/W" quantity="THERMAL_RESISTANCE" sign="m²*K/W"/>
	<UOM name="KILOWATT_PER_SQUAREMETER_PER_YEAR" id="kWh/m2/a" quantity="ENERGY_PER_AREA_PER_TIME" sign="kWh/m²/a"/>
	<UOM name="KILOGRAM_PER_SQUAREMETER_PER_YEAR" id="kg/m2/a" quantity="MASS_FLUX_PER_TIME" sign="kg/m²/a"/>
	<UOM name="KILOGRAM_PER_YEAR" id="kg/a" quantity="MASS_PER_TIME" sign="kg/a"/>
	<UOM name="MEGAJOULE_PER_YEAR" id="MJ/a" quantity="ENERGY_PER_TIME" sign="MJ/a"/>
	<UOM name="KILOJOULE_PER_KELVIN_SQUAREMETER" id="kJ/(K*m2)" quantity="AREAL_HEAT_CAPACITY" sign="kJ/(K·m²)"/>

	<!--
	======================================================================
	Additions proposed 2026-05-27
	======================================================================

	* kWh/a (KILOWATT_HOUR_PER_YEAR, ENERGY_PER_TIME):
	    CBS Postcode6 publishes per-dwelling annual electricity consumption
	    at kWh-scale (typical NL residential 2 000–4 000 kWh/a). UOMList
	    already has MJ/a, MWh/a, kg/a in ENERGY_PER_TIME / MASS_PER_TIME.

	* m3/a (CUBIC_METRE_PER_YEAR, VOLUME_PER_TIME):
	    CBS Postcode6 publishes per-dwelling annual natural-gas consumption
	    in m³/yr; the same unit fits annual water and liquid-fuel volumes.
	    UOMList previously offered m3/s and m3/h under FLOW_RATE, but
	    "flow rate" is the wrong semantic for an annual aggregate, there
	    is no instantaneous flow being measured. The proposed VOLUME_PER_TIME
	    quantity completes a three-way parallel that the existing v1.1
	    annual entries already established:
	          MASS_PER_TIME    : kg/a, kg/m2/a
	          ENERGY_PER_TIME  : MJ/a, MWh/a   (and the new kWh/a)
	          VOLUME_PER_TIME  : m3/a          (new)
	    The same VOLUME_PER_TIME slot would also host future l/a (litres
	    per year) and m3/m2/a (per-area-volumetric) entries cleanly.

	* W/W (EFFICIENCY_RATIO, DIMENSIONLESS_NUMBER):
	    PV module efficiency (electric W out / solar W in, typical 0.15–0.22)
	    and heat-pump COP (heat W out / electric W in, typical 3–6) are
	    both quoted as W/W in industry standards (IEC 61853 for PV; EN 14511
	    and EN 14825 for heat pumps), in EnergyADE-3.0-beta8 example data,
	    and in NL EP-online product datasheets. Collapsing to DIMENSIONLESS
	    "-" works numerically but strips the per-input-watt provenance a
	    downstream consumer needs to distinguish a COP from a price ratio,
	    a packing fraction, or a count. Adding W/W as a sibling of "-"
	    (same DIMENSIONLESS_NUMBER quantity, distinct id and sign) keeps
	    the rendering self-documenting without changing the unit algebra.

	Implementation note: the value of W/W staying its own id (rather than
	an altId of "-") is that the viewer's Properties panel will render the
	literal "W/W" sign, which is exactly the disambiguation the
	per-input-watt convention exists for. If kept as an altId of "-" the
	sign would collapse to "-" on read and the provenance would only
	survive in the source GML, not in the viewer's UI.
	-->
	<UOM name="KILOWATT_HOUR_PER_YEAR" id="kWh/a" quantity="ENERGY_PER_TIME" sign="kWh/a" description="Unit for annual energy (kilowatt-hours per annum); CBS (NL) publishes per-dwelling electricity at this sub-MWh scale"/>
	<UOM name="CUBIC_METRE_PER_YEAR" id="m3/a" quantity="VOLUME_PER_TIME" sign="m³/a" description="Unit for annual volume; CBS (NL) publishes per-dwelling natural-gas consumption in m³/yr, also fits annual water/fuel volumes. VOLUME_PER_TIME parallels the existing MASS_PER_TIME (kg/a) and ENERGY_PER_TIME (MJ/a, MWh/a) annual-aggregate quantities"/>
	<UOM name="EFFICIENCY_RATIO" id="W/W" quantity="DIMENSIONLESS_NUMBER" sign="W/W" description="Ratio of powers: PV module efficiency (electric W out / solar W in, ~0.15–0.22) and heat-pump COP (heat W out / electric W in, ~3–6). IEC 61853, EN 14511/14825 and NL EP-online datasheets all quote in W/W. Dimensionless but preserves the per-input-watt provenance a bare '-' would strip"/>
</UOMList>
