EP_ONLINE_API_KEY=your_ep_online_api_key_here

# On-demand CFTree tree generation (only needed when a city config carries a
# "vegetation.generate" block and its merged file is missing). The build runs
# CFTree for the AOI, then merges the result. These describe how to launch it
# on this machine; the build intent (ahn_version, n_cores) stays in the config.
#
# CFTREE_REPO    Path to the CFTree checkout. Defaults to a sibling ../CFTree.
# CFTREE_RUNNER  How to launch CFTree: "docker", "wsl" (default on Windows), or
#                "native".
#
# CFTREE_PYTHON  Interpreter that runs CFTree. Required for the wsl runner, e.g.
#                the cftree conda env's Python inside WSL.
#
# CFTREE_IMAGE       The CFTree image reference, required for the docker runner
#                    (e.g. cftree:local from a local build, or a published tag).
# CFTREE_DOCKER_ARGS Extra arguments passed to "docker run" before the image,
#                    for host tuning. Use "--gpus all" to enable the GPU
#                    morphometrics, and add --memory / --cpus / --shm-size as
#                    the host needs.
#
# Docker is the recommended setup for a colleague: it needs only Docker Desktop
# and a CFTree checkout, with no manual WSL distro, conda env, or C++ build. See
# the CFTree README "Run with Docker" section for the image build.
#
# --- docker runner (recommended) ---
# CFTREE_REPO=C:/Users/you/Documents/GitHub/CFTree
# CFTREE_RUNNER=docker
# CFTREE_IMAGE=cftree:local
# CFTREE_DOCKER_ARGS=--gpus all
#
# --- wsl runner ---
# CFTREE_REPO=C:/Users/you/Documents/GitHub/CFTree
# CFTREE_RUNNER=wsl
# CFTREE_PYTHON=/home/you/miniconda3/envs/cftree/bin/python
