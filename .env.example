EP_ONLINE_API_KEY=your_ep_online_api_key_here

# On-demand CFTree tree generation (only needed when a city config carries a
# "vegetation.generate" block and its merged file is missing). The build runs
# CFTree for the AOI, then merges the result. These describe how to launch it
# on this machine; the build intent (ahn_version, n_cores) stays in the config.
#
# CFTREE_RUNNER  How to launch CFTree: "docker" (recommended, the default on
#                Windows), "wsl", or "native" (the default elsewhere).
#
# CFTREE_IMAGE       The CFTree image reference, required for the docker
#                    runner. Use ghcr.io/daanschlosser/cftree:latest, published
#                    by CFTree CI; it is pulled automatically on first use, and
#                    its digest is part of the reuse check, so a re-pull or
#                    rebuild under the same tag regenerates stale tiles.
# CFTREE_WORKDIR     Where the docker runner keeps its cases/ and data/ work
#                    directories. Defaults to .cache/cftree in this repo.
# CFTREE_DOCKER_ARGS Extra arguments passed to "docker run" before the image,
#                    for host tuning (--memory, --cpus, --shm-size). On a
#                    machine with an NVIDIA container runtime, "--gpus all"
#                    enables the GPU morphometrics; without one it makes
#                    "docker run" fail outright, so leave it out by default.
#
# CFTREE_REPO    Path to a CFTree checkout. Not needed for the docker runner,
#                which runs the source baked into the image; setting it is the
#                development option (docker then mounts the checkout instead).
#                The wsl and native runners always need a checkout and default
#                to a sibling ../CFTree.
# CFTREE_PYTHON  Interpreter that runs CFTree, for the wsl and native runners
#                (e.g. the cftree conda env's Python inside WSL).
#
# Docker is the recommended setup: it needs only Docker Desktop, with no CFTree
# checkout, WSL distro, conda env, or C++ build. The wsl and native runners
# remain for development against a local checkout.
#
# --- docker runner (recommended, default on Windows) ---
# CFTREE_RUNNER=docker
# CFTREE_IMAGE=ghcr.io/daanschlosser/cftree:latest
#
# --- wsl runner (development) ---
# CFTREE_REPO=C:/Users/you/Documents/GitHub/CFTree
# CFTREE_RUNNER=wsl
# CFTREE_PYTHON=/home/you/miniconda3/envs/cftree/bin/python
#
# --- native runner (development, Linux or a native conda env) ---
# CFTREE_REPO=/home/you/CFTree
# CFTREE_RUNNER=native
# CFTREE_PYTHON=/home/you/miniconda3/envs/cftree/bin/python
